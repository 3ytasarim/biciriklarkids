# ── Veritabanı (Neon PostgreSQL) ──
# Uygulama sorguları: Neon "pooled" bağlantı (host'ta -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require
# Migration: doğrudan (pooler OLMAYAN) host
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require

# ── Site ──
# Production'da zorunlu: https:// ve gerçek alan adı (canonical, sitemap, OG, JSON-LD bu değerden üretilir)
NEXT_PUBLIC_SITE_URL=https://www.biciriklar.com.tr
# IP adresleri ham saklanmaz; rate limit için tuzlu özet alınır. Production'da uzun rastgele değer verin.
IP_HASH_SALT=

# ── Dosya deposu ──
# Varsayılan: ./storage/uploads (kalıcı disk). Vercel gibi geçici diskli ortamda S3/R2 sürücüsü gerekir (TODO).
# UPLOAD_DIR=/var/lib/biciriklar/uploads

# ── Analytics / Pazarlama (boş bırakılırsa ilgili script hiç yüklenmez) ──
# Admin › Ayarlar'dan da girilebilir; ENV değeri önceliklidir.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── iyzico (kartla ödeme — Checkout Form) ──
# Anahtarlar iyzico panelinden: Ayarlar › Firma Ayarları › API Anahtarları. Üçü de doluysa "Kredi / Banka Kartı" görünür.
# Test: https://sandbox-api.iyzipay.com (sandbox-merchant.iyzipay.com'dan alınan sandbox anahtarlarıyla)
# Canlı: https://api.iyzipay.com
# iyzico anahtarları Admin › Ayarlar › Kartla ödeme bölümünden de girilebilir (ENV tanımlıysa ENV önceliklidir).
# Admin'den girilen gizli anahtar şifreli saklanır; şifreleme anahtarı SETTINGS_SECRET (isteğe bağlı), yoksa DATABASE_URL'den türetilir.
# SETTINGS_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# İsteğe bağlı taksit seçenekleri (1,2,3,6,9,12 arasından)
IYZICO_INSTALLMENTS=1,2,3,6,9

# ── Diğer ödeme sağlayıcıları (gerekirse) ──
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
